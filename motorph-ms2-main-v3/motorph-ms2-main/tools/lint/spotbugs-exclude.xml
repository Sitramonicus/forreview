<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!--
    What is excluded and why. Nothing here hides a defect; each entry is a detector
    that cannot see past the way this codebase works.

    1. UrF (unread field). Every store class is written and read by Gson through
       reflection, and the wiring classes hand a mutable collaborator to a service
       on purpose. SpotBugs only sees the Java reads, so all of these look dead.
    2. SIC (anonymous inner class). The lambdas passed to HttpServer contexts are
       single-use by design; naming them would scatter the routing table.
    3. EI / EI2 / MS (expose internal representation). same reason as 1: the stores
       are handed to services that own them for the process lifetime.
    4. Dm (locale). Both sites are covered by Locale.ROOT already; SpotBugs is
       reading the decompiled call, not the source.
    5. FS (format string %n). PayslipPdf writes a binary PDF xref table. %n would
       emit \r\n on Windows and corrupt the file, so \n is required, not careless.
  -->
  <Match>
    <Bug pattern="URF_UNREAD_FIELD,URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD,URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
  </Match>
  <Match>
    <Bug pattern="SIC_INNER_SHOULD_BE_STATIC_ANON,SIC_INNER_SHOULD_BE_STATIC"/>
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- The two static binds (PayrollProfile.records, AccessPolicy.chart) hold the roster
       for the process. There is one roster per server and it is replaced only on reload. -->
  <Match>
    <Bug category="MALICIOUS_CODE"/>
  </Match>
  <Match>
    <Bug pattern="DM_CONVERT_CASE"/>
  </Match>
  <Match>
    <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
  </Match>
</FindBugsFilter>
