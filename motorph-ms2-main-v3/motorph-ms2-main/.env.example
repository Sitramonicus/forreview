# MotorPH — server configuration
#
# Nothing here is required to run the app: with no configuration it stores data in
# data/local-demo.json and serves the built-in roster. Copy the parts you need.
#
# The browser never talks to Firebase. Sign-in is employee number + password, handled by the
# Java server; Firestore is used only by the server, as its data store.

# ---- Firestore as the data store ------------------------------------------
# Copy this file to .env, fill in the three lines below, then run: sh run.sh
# run.sh reads .env by itself. Nobody pastes tokens; the server renews its own access.
#
# 1. Firebase console > Project settings > Service accounts > Generate new private key.
#    Save the JSON outside this folder and put its full path here.
# GOOGLE_APPLICATION_CREDENTIALS=C:/keys/motorph-server.json
# 2. The Firebase project ID.
# FIREBASE_PROJECT_ID=motorph-jd
# 3. Any secret of 32+ characters. Keep it the same forever, or saved passwords stop working.
# MOTORPH_PEPPER=<stable secret of at least 32 characters>

# Point the server at a Firestore emulator (or any service speaking the same REST subset).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8099

# Firestore saves are always synchronous. Local files can opt into deferred saves,
# but a successful response can then precede persistence.
# MOTORPH_DEFER_SAVES=false

# ---- Data files ------------------------------------------------------------
# LOCAL_DATA_FILE=data/local-demo.json
# MOTORPH_SEED_FILE=data/local-demo.json   # copied into a brand-new, empty backend

# ---- Server ----------------------------------------------------------------
# PORT=8080
# HOST=0.0.0.0
# WEB_ROOT=web
# MOTORPH_PEPPER=<at least 32 characters; used to derive password hashes>
